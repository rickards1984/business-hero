#!/usr/bin/env bash
# Business Hero — pre-push gate.
#
# The working agreement says "iterate until green". This makes that mechanical
# rather than voluntary: a push that would carry a red tree is refused here,
# before it reaches a branch a reviewer or Railway might act on.
#
# Installed by:  git config core.hooksPath .githooks
# (Set once per clone. Worktrees share the main .git config, so one setting
# covers every worktree.)
#
# --no-verify is NOT PERMITTED. See docs/DEVELOPMENT_WORKFLOW.md. If the gate
# is wrong, fix the gate in a ticket — do not step around it, because the next
# person cannot tell a deliberate bypass from a forgotten one.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# A branch deletion pushes an all-zeros local sha and has no tree to verify.
DELETE_ONLY=1
PUSHED_SHAS=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in
    *[!0]*) DELETE_ONLY=0; PUSHED_SHAS="$PUSHED_SHAS $local_sha" ;;
  esac
done

if [ "$DELETE_ONLY" -eq 1 ]; then
  echo "pre-push: branch deletion only — nothing to verify."
  exit 0
fi

# ./check.sh verifies the WORKING TREE. That is only evidence about the commit
# being pushed if the two are the same thing. Review 001 finding 11: pushing a
# ref other than HEAD, or pushing with uncommitted fixes in the tree, made the
# gate verify content that was not what the reviewer would receive.
#
# SUPPORTED PUSH TYPES (re-review made these explicit rather than emergent):
#   - a branch whose tip is HEAD                          -> verified, allowed
#   - a lightweight or annotated tag pointing AT HEAD      -> allowed (the tag
#     object's own SHA differs from the commit, so it is peeled with ^{commit}
#     before comparing; the previous version refused every annotated tag)
#   - a branch or tag pointing at any other commit         -> REFUSED
#   - a deletion                                           -> allowed, nothing
#     to verify
# Anything pushed must resolve to the commit this gate actually tested.
HEAD_SHA="$(git rev-parse HEAD)"
for sha in $PUSHED_SHAS; do
  # Peel tag objects to the commit they point at. A non-commit that cannot be
  # peeled is refused rather than assumed harmless.
  if ! target="$(git rev-parse -q --verify "${sha}^{commit}" 2>/dev/null)"; then
    echo "pre-push: REFUSED — $sha does not resolve to a commit." >&2
    exit 1
  fi
  if [ "$target" != "$HEAD_SHA" ]; then
    kind="$(git cat-file -t "$sha" 2>/dev/null || echo unknown)"
    cat >&2 <<MSG
pre-push: REFUSED — you are pushing a revision that is not your HEAD.

  pushing:        $sha ($kind)
  which resolves: $target
  HEAD:           $HEAD_SHA

./check.sh verifies the working tree, so it proves nothing about $target.
Check out the revision you intend to push and push from there.
MSG
    exit 1
  fi
done

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  cat >&2 <<'MSG'
pre-push: REFUSED — the working tree has uncommitted tracked changes.

./check.sh would verify your working tree, which is NOT what you are
pushing. Commit or stash them, then push, so the gate and the pushed
commit are the same content.
MSG
  git status --short --untracked-files=no >&2
  exit 1
fi

# Untracked, non-ignored files are work that exists locally and does not exist
# in the pushed commit. check.sh may have imported a helper or collected a test
# from one, in which case the gate tested content the reviewer will not get.
# Ignored files (node_modules, .venv, scratch) are not affected.
UNTRACKED="$(git ls-files --others --exclude-standard)"
if [ -n "$UNTRACKED" ] && [ "${PREPUSH_ALLOW_UNTRACKED:-0}" != "1" ]; then
  cat >&2 <<'MSG'
pre-push: REFUSED — untracked files are present.

These exist in your working tree but not in the commit you are pushing, so
./check.sh may have verified content the pushed commit does not contain
(an imported helper, a collected test):
MSG
  printf '%s\n' "$UNTRACKED" | sed 's/^/    /' >&2
  cat >&2 <<'MSG'

Commit them, add them to .gitignore, or remove them. If they genuinely
cannot affect the gate, re-run with:

    PREPUSH_ALLOW_UNTRACKED=1 git push ...

That escape is deliberate and visible in your shell history. --no-verify
is still not permitted: it disables the gate entirely rather than
narrowing one documented check.
MSG
  exit 1
fi

if [ ! -x ./check.sh ]; then
  echo "pre-push: REFUSED — ./check.sh is missing or not executable." >&2
  echo "          The verification gate cannot run, so the push cannot be trusted." >&2
  exit 1
fi

echo "pre-push: running ./check.sh full ..."
echo

if ./check.sh full; then
  echo
  echo "pre-push: green. Pushing."
  exit 0
fi

cat >&2 <<'MSG'

────────────────────────────────────────────────────────────────────
  PUSH REFUSED — ./check.sh full is red.
────────────────────────────────────────────────────────────────────
  Fix it and push again. The output above names the failing step.

  Do NOT use --no-verify. It is not permitted by the working
  agreement (docs/DEVELOPMENT_WORKFLOW.md). A bypassed gate is
  indistinguishable from a forgotten one to the next reader, and
  this branch is what a reviewer and Mike's merge will act on.

  If the gate itself is wrong, that is a ticket, not a bypass.
────────────────────────────────────────────────────────────────────
MSG
exit 1
